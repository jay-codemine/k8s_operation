Server:
  RunMode: release
  Port: 8080
  ReadTimeout: 3600
  WriteTimeout: 3600
  IdleTimeout: 300
  ShutdownTimeout: 300
  ReadinessTimeout: 2       # 就绪探针 DB Ping 超时(秒)，需小于 K8s readinessProbe 的 timeoutSeconds；外部/公网 MySQL 建议 2~3s

Database:
  DBType: mysql
  Username: root
  Password: admin123
  Host: localhost
  Port: 3306
  DBName: k8s-platform
  Charset: utf8
  ParseTime: true
  MaxIdleConns: 5
  MaxOpenConns: 100
  MaxLifeSeconds: 300

Cache:
  Type: redis
  Name: sk_sid
  Address: 127.0.0.1:6379
  Username: "root"
  Password: "admin123"
  MaxConnect: 10
  Network: tcp
  Secret: "k8smana"

App:
  LogLevel: debug
  TIMEZONE: "Asia/Shanghai"
  LogType: single
  LogFileName: storage/logs/app.log         # 系统日志
  LogMaxSize: 1
  LogMaxBackup: 3
  LogMaxAge: 30
  LogCompress: true
  BusinessLogFileName: storage/logs/biz.log # 业务日志（新增）
  MirrorBusinessToSystem: false             # 是否将业务日志镜像到系统日志（新增）
  JWTMaxRefreshTime: 86400
  JWTSigningKey: xxxx
  JWTExpireTime: 120000
  AppName: "k8operation"
  GlobalKubeConfigPath: configs/k8s.yaml
  DefaultClusterID: 2     # 可选，如走 DB 的默认集群
  AutoInitK8s: true          # 可选，是否开机自动初始化
  SkipAutoMigrate: true      # 推荐：数据库已由完整 init.sql 初始化，跳过 GORM 自动建表（避免启动时多余迁移）

PodLog:
  EnableStreaming: false   # true=实时跟随（流式）；false=一次性字符串
  TailDefault: 500         # 默认返回最后 N 行
  TailMax: 5000            # N 的上限，防止一次拉太多
  LimitBytes: 2097152      # 服务器端返回体上限（2MB），再保险
  Timestamps: false        # 是否给每行带时间戳（按需）
  Previous: false          # 是否读取上一次崩溃日志（按需）


ErrorCode:
  AllowOverride: true   # 是否允许错误码覆盖（true: 开发模式；false: 生产模式）

ClusterClient:
  TTL: 30m
  TTLJitter: 3m


Pod:
  eviction:
    default_grace_seconds: 30

Node:
  drain:
    max_grace_seconds: 300
    ignore_daemon_sets: true
    delete_empty_dir: false


Jenkins:
  URL: "http://jenkins.devops.svc.cluster.local:8080/"  # K8s 集群内 Jenkins Service 地址
  Username: "admin"
  APIToken: "xxxxxxxx"
  TriggerTimeout: 60
  CallbackURL: "http://k8soperation-backend.k8soperation.svc.cluster.local:38180"  # 后端 Service 地址
  PlatformURL: "http://k8soperation-frontend.k8soperation.svc.cluster.local"       # 前端 Service 地址
  # 凭证 ID 配置（可选，留空则用默认值，对应 Jenkins Credentials 中的 ID）
  GitCredentialID: "gitee-id"           # Git 凭证 ID
  RegistryCredentialID: "harbor-registry" # 镜像仓库凭证 ID
  HMACCredentialID: "hmac-secret"        # HMAC 签名凭证 ID
  # Git 默认认证（供平台侧「检测仓库/获取分支」直接访问私有仓库；配一次后自动复用，无需每次手输）
  GitUsername: ""                        # Git 用户名（Gitee 可用 oauth2 或账号名；GitHub 可留空只填 Token）
  GitToken: ""                          # Git 密码或 Personal Access Token（与 Jenkins gitee-id 同源）
  HMACSecret: "xxxxx3VbN6dHe1Zx4JuWq"
  PollInterval: 15
  MaxBuildTime: 30
  # 通知配置
  EnableDingTalk: true                          # 是否启用钉钉通知
  DingTalkWebhook: "xxxx"                       # 钉钉机器人 Webhook URL
  EnableFeishu: false                           # 是否启用飞书通知
  FeishuWebhook: ""                             # 飞书机器人 Webhook URL（EnableFeishu=true 时填写）
  FeishuSecret: ""                              # 飞书机器人签名密钥（可选）

# ============================================================
# GitOps 配置 (ArgoCD + Argo Workflows)
# 可选 — 不配置则 GitOps 模式不可用，Jenkins 模式不受影响
# ============================================================
GitOps:
  ArgoCDURL: ""                                   # ArgoCD API Server 地址
  ArgoCDAuthToken: ""                             # ArgoCD Auth Token
  ArgoWorkflowsURL: ""                            # Argo Workflows Server 地址
  ArgoWorkflowsToken: ""                          # Argo Workflows Auth Token
  CallbackURL: "http://k8soperation-backend:38180" # 平台回调地址
  HMACSecret: ""                                  # HMAC 签名密钥
  GitManifestRepo: ""                             # 默认 Git Manifest 仓库
  GitManifestPath: "manifests"                    # 默认 manifests 路径
  GitCredentialID: "git-ssh-key"                  # Git 凭证 ID
  EnableDingTalk: false                           # 是否启用钉钉通知
  DingTalkWebhook: ""                             # 钉钉机器人 Webhook
  EnableFeishu: false                             # 是否启用飞书通知
  FeishuWebhook: ""                               # 飞书机器人 Webhook
  FeishuSecret: ""                                # 飞书机器人签名密钥
  SyncPollInterval: 10                            # 同步状态轮询间隔(秒)
  SyncMaxWaitTime: 600                            # 最大等待同步完成时间(秒)

# ============================================================
# CICD 部署 Worker 配置
# 可选 — 不配置时默认并发数 3
# ============================================================
CicdWorker:
  Concurrency: 3                                  # 部署任务消费协程数（单实例同时处理的部署任务上限）

# ============================================================
# 监控数据源（仅作为首次启动的引导值，不是运行期的权威配置）
#
# 设计原则（生产环境推荐）：
#   1. 启动期：若 DB 中无任何 prometheus 数据源，则把下方 PrometheusURL 自动 INSERT 一条作为默认数据源；
#      若 DB 中已有数据源，则忽略此处配置。
#   2. 运行期：所有增/删/改、切换默认 全部由前端【数据源管理】写入 DB，无需改 config.yaml、无需重启。
#   3. 多副本部署：DB 是共享存储，前端改一次所有副本即时生效；config.yaml 是各副本独立的。
#   4. 正式上线后，建议把下方配置块删掉（或留空），完全以 DB 为准；启动日志会打印"实际生效数据源"。
#
# 优先级：DB.is_default=1 > DB.任一 enabled=1 > 下方 PrometheusURL（最低兜底）
# ============================================================
Monitoring:
  Enabled: true
  PrometheusURL: "http://prometheus.monitoring.svc:9090"  # 首次启动引导值，DB 有数据后此项将被忽略
  QueryTimeout: 30

# AI 助手配置（基于 ChatGPT）
AIAssistant:
  Enabled: false                          # 是否启用 AI 助手
  APIKey: "sk-xxxxxxxxxxxx"               # OpenAI API Key
  BaseURL: ""                             # 自定义 API 地址（留空则用官方，国内可填代理地址）
  Model: "gpt-4o"                         # 模型名称
  MaxTokens: 2048                         # 最大 Token 数
  Temperature: 0.7                        # 温度参数 (0-2)
  SystemPrompt: ""                        # 自定义 System Prompt（留空用默认）
  ApprovalExpire: 30                      # 高危操作审批过期时间(分钟)
  MaxHistoryRound: 20                     # 会话最大保留历史轮数