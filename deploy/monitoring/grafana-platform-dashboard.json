      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "histogram_quantile(0.99, sum(rate(k8sop_http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}", "range": true, "refId": "A" }],
      "title": "API P99 延迟", "type": "timeseries"
