      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 19 },
      "id": 10, "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "k8sop_db_connection_pool_active", "legendFormat": "__auto", "range": true, "refId": "A" }],
      "title": "DB 连接池使用率", "type": "gauge"
    },
