      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "histogram_quantile(0.50, sum(rate(k8sop_cicd_pipeline_duration_seconds_bucket[1h])) by (le, pipelinename))", "legendFormat": "P50 {{pipelinename}}", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum(rate(k8sop_cicd_pipeline_duration_seconds_bucket[1h])) by (le, pipelinename))", "legendFormat": "P95 {{pipelinename}}", "range": true, "refId": "B" }
      ],
