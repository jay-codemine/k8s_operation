      "targets": [{ "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "editorMode": "code", "expr": "sum(rate(k8sop_cicd_pipeline_runs_total{status=\"success\"}[24h])) / sum(rate(k8sop_cicd_pipeline_runs_total[24h])) * 100", "legendFormat": "__auto", "range": true, "refId": "A" }],
      "title": "CICD 成功率 (24h)", "type": "stat"
