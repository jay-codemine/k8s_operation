# ============================================================
# K8sOperation 敏感配置 Secret（示例模板）
# 使用方法：
#   1. 复制此文件：cp secret.yaml.example secret.yaml
#   2. 填写实际值
#   3. 部署：kubectl apply -f deploy/backend/secret.yaml
#
# ⚠️ 注意：secret.yaml 包含敏感信息，已加入 .gitignore，禁止提交到 Git
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: k8soperation-secret
  namespace: k8soperation
  labels:
    app.kubernetes.io/name: k8soperation
type: Opaque
stringData:
  # 数据库配置
  DB_TYPE: "mysql"
  DB_USERNAME: "<your-db-username>"
  DB_PASSWORD: "<your-db-password>"
  DB_HOST: "<your-db-host>"
  DB_PORT: "3306"
  DB_NAME: "k8s-platform"
  DB_CHARSET: "utf8mb4"
  DB_PARSE_TIME: "true"
  DB_MAX_IDLE_CONNS: "10"
  DB_MAX_OPEN_CONNS: "100"
  DB_MAX_LIFE_SECONDS: "300"
  # Redis/Cache 配置
  CACHE_TYPE: "redis"
  CACHE_NAME: "sk_sid"
  REDIS_PASSWORD: "<your-redis-password>"          # 无密码则留空 ""
  REDIS_ADDRESS: "<your-redis-host>:6379"          # Redis Cluster 模式可留空
  CACHE_USERNAME: ""                                # Redis 6+ ACL 用户，无则留空
  CACHE_MAX_CONNECT: "10"
  CACHE_NETWORK: "tcp"
  CACHE_SECRET: "<random-session-secret>"
  # JWT 签名密钥（至少 16 字符）
  JWT_SIGNING_KEY: "<your-jwt-signing-key>"
  # Jenkins 配置
  JENKINS_URL: "http://jenkins.devops.svc.cluster.local:8080/"
  JENKINS_USERNAME: "ops-dev"
  JENKINS_API_TOKEN: "<your-jenkins-api-token>"
  # HMAC 签名密钥
  HMAC_SECRET: "<your-hmac-secret>"
  # KubeConfig 加密密钥
  KUBECONFIG_ENCRYPT_KEY: "<your-encryption-key>"
  # Jenkins 凭证 ID（对应 Jenkins 中的 Credentials ID）
  GIT_CREDENTIAL_ID: "gitee-id"
  REGISTRY_CREDENTIAL_ID: "harbor-registry"
  HMAC_CREDENTIAL_ID: "hmac-secret"
  # 通知开关
  ENABLE_DINGTALK: "true"
  ENABLE_FEISHU: "false"
  FEISHU_WEBHOOK: ""
  FEISHU_SECRET: ""
  # 钉钉 Webhook（可选）
  DINGTALK_WEBHOOK: ""
  # 前端公网地址
  PLATFORM_FRONTEND_URL: "http://localhost:5173"
