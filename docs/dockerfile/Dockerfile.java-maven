# Dockerfile - Java Maven 项目多阶段构建
# ============================================
# 特点：
#   - 多阶段构建，分离编译和运行环境
#   - 使用 JRE 运行镜像减小体积
#   - 支持健康检查和 JVM 调优
#   - 支持 OTEL Agent 探针注入
# ============================================

# ============ 构建参数 ============
ARG JAVA_VERSION=17

# ============ 构建阶段 ============
FROM maven:3.9-eclipse-temurin-${JAVA_VERSION} AS builder
WORKDIR /build

# 先复制 pom.xml 利用缓存
COPY pom.xml .
RUN mvn dependency:go-offline -B

# 复制源码并构建
COPY src ./src
RUN mvn package -DskipTests -B && \
    mv target/*.jar app.jar

# ============ 运行阶段 ============
# 使用 jammy (Ubuntu 22.04) 基底，自带 glibc，兼容 snappy-java/Netty/RocksDB
FROM eclipse-temurin:${JAVA_VERSION}-jre-jammy

# 安装时区 + 常用诊断工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata curl && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    rm -rf /var/lib/apt/lists/*

# 创建非 root 用户
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# 从构建阶段复制 JAR
COPY --from=builder /build/app.jar ./app.jar

# 复制 OTEL Agent（可选，由平台自动注入）
# COPY --from=otel /opentelemetry-javaagent.jar /app/opentelemetry-javaagent.jar

# 切换到非 root 用户
USER appuser

# 暴露端口
EXPOSE 8080

# JVM 参数（可通过环境变量覆盖）
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp"
ENV OTEL_OPTS=""

# 健康检查（支持 Spring Boot Actuator 和普通 HTTP）
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD curl -sf http://localhost:8080/actuator/health || curl -sf http://localhost:8080/health || exit 1

# 启动命令
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS $OTEL_OPTS -jar app.jar"]
